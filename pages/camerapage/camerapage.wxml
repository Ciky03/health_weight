<view class="camerapage-root">
  <!-- 顶部返回按钮 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">
      <icon type="arrow-left" size="28" color="#333" />
    </view>
    <view class="nav-bar-right"></view>
  </view>

  <!-- 图片展示 -->
  <view class="image-section">
    <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" class="preview-image"></image>
  </view>

  <!-- 食品信息卡片 -->
  <view class="food-card">
    <view class="food-title">青提乌龙茶</view>
    <view class="food-unit-row">
      <text class="food-unit-cal">{{unit=='份' ? '1 千卡/份' : '1 千卡/100克'}}</text>
      <view class="unit-switch">
        <view class="unit-btn {{unit=='份'?'active-unit':''}}" bindtap="switchUnit" data-unit="份">份</view>
        <view class="unit-btn {{unit=='克'?'active-unit':''}}" bindtap="switchUnit" data-unit="克">克</view>
      </view>
    </view>
    <view class="food-amount-row">
      <button class="amount-btn" size="mini" bindtap="decrease">-</button>
      <view class="amount-value-box">
        <text wx:if="{{!showInput}}" class="amount-value" bindtap="showInputBox">{{amount}}</text>
        <input wx:if="{{showInput}}" class="amount-input" type="number" value="{{amount}}" bindinput="inputAmount" placeholder="输入数量" focus="true" bindblur="hideInputBox" />
      </view>
      <button class="amount-btn" size="mini" bindtap="increase">+</button>
    </view>
    <view class="food-total-row">
      <text>总卡路里</text>
      <text class="food-total-kcal">{{totalKcal}} kcal</text>
    </view>
  </view>

  <!-- 底部保存按钮 -->
  <view class="save-bar">
    <view class="save-label">总卡路里</view>
    <view class="save-value">{{totalKcal}} kcal</view>
    <button class="save-btn" bindtap="saveRecord">保存记录</button>
  </view>
</view> 