<view class="camerapage-root">
  <!-- 顶部返回按钮 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">
      <icon type="arrow-left" size="28" color="#333" />
    </view>
    <view class="nav-bar-right"></view>
  </view>

  <!-- 图片展示 -->
  <view class="image-section">
    <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" class="preview-image"></image>
  </view>

  <!-- 食品信息卡片列表 -->
  <view class="food-cards-container">
    <view class="food-card" wx:for="{{foods}}" wx:key="index">
      <view class="food-title">{{item.name}}</view>

      <view class="food-unit-row">
        <text class="food-unit-cal">{{item.calorie}} 千卡/100克</text>
      </view>

      <view class="food-amount-row">
        <button class="amount-btn" size="mini" bindtap="decrease" data-index="{{index}}">-</button>
        <view class="amount-value-box">
          <text wx:if="{{!item.showInput}}" class="amount-value" bindtap="showInputBox" data-index="{{index}}">{{item.amount || 0}}</text>
          <block wx:if="{{item.showInput}}">
            <input class="amount-input" type="digit" value="{{item.amount || 0}}" 
                   bindinput="inputAmount" data-index="{{index}}" placeholder="输入克数" focus="true" bindblur="hideInputBox" />
          </block>
        </view>
        <button class="amount-btn" size="mini" bindtap="increase" data-index="{{index}}">+</button>
        <text class="unit-text">克</text>
      </view>

      <view class="food-total-row">
        <text>总卡路里</text>
        <text class="food-total-kcal">{{item.amount * item.calorie / 100}} 千卡</text>
      </view>
    </view>
  </view>

  <!-- 底部保存按钮 -->
  <view class="save-bar">
    <view class="save-label">总卡路里</view>
    <view class="save-value">{{totalCalories}} 千卡</view>
    <button class="save-btn" bindtap="saveRecord">保存记录</button>
  </view>
</view> 