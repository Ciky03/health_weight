.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 转换为食物卡片后的样式 */
.search-bar.food-card {
  margin: 0 10rpx 20rpx 10rpx;
  width: calc(100% - 20rpx);
  border-radius: 16rpx;
}

.input-group {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  height: 32rpx;
}

.input-group:first-child {
  border-right: 1rpx solid #eee;
}

.search-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.calorie-input {
  width: 100rpx;
  font-size: 32rpx;
  color: #333;
  text-align: center;
}

.unit-text {
  font-size: 32rpx;
  color: #999;
  margin-left: 10rpx;
}

.search-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}

.search-icon {
  width: 100%;
  height: 100%;
}

/* 食物卡片样式 */
.food-card {
  padding: 30rpx;
}

.food-card-content {
  width: 100%;
}

.food-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.food-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.calories-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.food-calories {
  font-size: 28rpx;
  color: #666;
}

.gram-btn {
  display: inline-block;
  padding: 4rpx 20rpx;
  background: #f3ae58;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.amount-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.minus-btn, .plus-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
  background: #fff;
  border-radius: 8rpx;
}

.amount-input {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  background: transparent;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.total-label {
  color: #666;
}

.total-value {
  color: #f3ae58;
  font-size: 32rpx;
  font-weight: 500;
}

/* 食物列表样式 */
.food-list {
  flex: 1;
  margin-bottom: 120rpx;
}

.food-item {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

/* 底部按钮样式 */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-btn, .save-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin: 0 10rpx;
}

.add-btn {
  background: #fff;
  color: #333;
  border: 2rpx solid #ddd;
}

.save-btn {
  background: #f3ae58;
  color: #fff;
  border: none;
}

.delete-btn {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-card-btn {
  margin-top: 20rpx;
  padding-top: 20rpx;
  text-align: center;
  color:#f3ae58;
  font-size: 30rpx;
  font-weight: 400;
  border-top: 1rpx solid #eee;
} 