.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.input-group {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.calorie-input {
  width: 100rpx;
  font-size: 32rpx;
  color: #333;
  text-align: center;
}

.unit-text {
  font-size: 32rpx;
  color: #999;
  margin-left: 10rpx;
}

.search-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-radius: 16rpx;
  padding: 16rpx;
}

.search-icon {
  width: 100%;
  height: 100%;
}

/* 食物列表样式 */
.food-list {
  flex: 1;
  margin-bottom: 120rpx;
}

.food-item {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

/* 底部按钮样式 */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-btn, .save-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.add-btn {
  background: #fff;
  color: #333;
  border: 2rpx solid #ddd;
}

.save-btn {
  background: #f3ae58;
  color: #fff;
  border: none;
} 