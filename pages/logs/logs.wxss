page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.log-item {
  margin-top: 20rpx;
  text-align: center;
}
.log-item:last-child {
  padding-bottom: env(safe-area-inset-bottom);
}

.container {
  padding: 0;
  background: #fff;
}

/* 年月选择器 */
.date-picker {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.picker-item {
  font-size: 32rpx;
  color: #333;
  padding: 12rpx 30rpx;
  background: #fff;
  border-radius: 8rpx;
  margin: 0 20rpx;
}

/* 日历主体 */
.calendar {
  padding: 0;
  width: 100%;
}

.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  padding: 20rpx 0;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.week-day {
  font-size: 28rpx;
  color: #999;
  height: 60rpx;
  line-height: 60rpx;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 5rpx 0;
  background: #fff;
}

.day-item {
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 5rpx 0;
}

.day-number {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 4rpx;
  position: relative;
  z-index: 2;
}

.calorie-value {
  font-size: 24rpx;
  color: #f3ae58;
  position: relative;
  z-index: 2;
}

.day-item:not(.current) {
  color: #ccc;
}

.day-item.selected {
  background: rgba(243, 174, 88, 0.1);
  position: relative;
}

.day-item.selected::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid #f3ae58;
  z-index: 1;
}

.day-item.selected .day-number {
  color: #f3ae58;
  font-weight: bold;
}

.day-item.today .day-number {
  font-weight: bold;
}

/* 时间段列表 */
.time-slots {
  background: #fff;
  margin-top: 20rpx;
}

.time-slot-group {
  border-bottom: 1rpx solid #eee;
}

.time-slot-group:last-child {
  border-bottom: none;
}

.time-slot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
}

.slot-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.period-calories {
  font-size: 24rpx;
  color: #f3ae58;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
  transition: transform 0.3s ease;
}

.arrow.expanded {
  transform: rotate(90deg);
}

.time-content {
  background: #fff;
  padding: 0 30rpx;
}

.food-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.food-item:last-child {
  border-bottom: none;
}

.food-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.food-name {
  font-size: 28rpx;
  color: #333;
}

.food-time {
  font-size: 24rpx;
  color: #999;
}

.food-calories {
  font-size: 28rpx;
  color: #f3ae58;
}

.no-food {
  text-align: center;
  color: #999;
  padding: 30rpx 0;
  font-size: 28rpx;
}

/* 联系信息样式 */
.contact-info {
  text-align: center;
  padding: 20rpx;
  color: #666;
  font-size: 28rpx;
  background: #f8f8f8;
}

