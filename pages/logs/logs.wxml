<!--logs.wxml-->
<view class="container">
  <!-- 年月选择器 -->
  <view class="date-picker">
    <picker mode="selector" range="{{years}}" value="{{yearIndex}}" bindchange="onYearChange">
      <view class="picker-item">{{selectedYear}}年</view>
    </picker>
    <picker mode="selector" range="{{months}}" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="picker-item">{{selectedMonth}}月</view>
    </picker>
    <view class="view-type">
      <view class="{{viewType === 'month' ? 'active' : ''}}" bindtap="switchViewType" data-type="month">月</view>
    </view>
  </view>

  <!-- 日历主体 -->
  <view class="calendar">
    <!-- 星期头部 -->
    <view class="week-header">
      <view wx:for="{{weekDays}}" wx:key="index" class="week-day">{{item}}</view>
    </view>
    <!-- 日期格子 -->
    <view class="days-grid">
      <view wx:for="{{days}}" wx:key="index" 
            class="day-item {{item.current ? 'current' : ''}} {{item.selected ? 'selected' : ''}} {{item.today ? 'today' : ''}}"
            bindtap="selectDate" data-date="{{item}}">
        <view class="day-number">{{item.day}}</view>
        <view class="calorie-value" wx:if="{{item.calories}}">{{item.calories}}</view>
      </view>
    </view>
  </view>

  <!-- 时间段选择 -->
  <view class="time-slots">
    <!-- 上午 -->
    <view class="time-slot-group">
      <view class="time-slot {{expandedSlot === '上午' ? 'expanded' : ''}}" bindtap="toggleTimeSlot" data-time="上午">
        <view class="slot-header">
          <text>上午</text>
          <text class="period-calories" wx:if="{{periodCalories.morning > 0}}">{{periodCalories.morning}}千卡</text>
        </view>
        <view class="arrow {{expandedSlot === '上午' ? 'expanded' : ''}}">></view>
      </view>
      <view class="time-content" wx:if="{{expandedSlot === '上午'}}">
        <block wx:for="{{dailyCalorieDetail.todayDetails}}" wx:key="index">
          <view class="food-item" wx:if="{{item.intakePeriod === 0}}">
            <view class="food-info">
              <text class="food-name">{{item.foodName}}</text>
              <text class="food-time">{{item.intakeTime}}</text>
            </view>
            <text class="food-calories">{{item.calories}}千卡</text>
          </view>
        </block>
        <view class="no-food" wx:if="{{!periodCalories.morning}}">暂无记录</view>
      </view>
    </view>

    <!-- 中午 -->
    <view class="time-slot-group">
      <view class="time-slot {{expandedSlot === '中午' ? 'expanded' : ''}}" bindtap="toggleTimeSlot" data-time="中午">
        <view class="slot-header">
          <text>中午</text>
          <text class="period-calories" wx:if="{{periodCalories.noon > 0}}">{{periodCalories.noon}}千卡</text>
        </view>
        <view class="arrow {{expandedSlot === '中午' ? 'expanded' : ''}}">></view>
      </view>
      <view class="time-content" wx:if="{{expandedSlot === '中午'}}">
        <block wx:for="{{dailyCalorieDetail.todayDetails}}" wx:key="index">
          <view class="food-item" wx:if="{{item.intakePeriod === 1}}">
            <view class="food-info">
              <text class="food-name">{{item.foodName}}</text>
              <text class="food-time">{{item.intakeTime}}</text>
            </view>
            <text class="food-calories">{{item.calories}}千卡</text>
          </view>
        </block>
        <view class="no-food" wx:if="{{!periodCalories.noon}}">暂无记录</view>
      </view>
    </view>

    <!-- 下午 -->
    <view class="time-slot-group">
      <view class="time-slot {{expandedSlot === '下午' ? 'expanded' : ''}}" bindtap="toggleTimeSlot" data-time="下午">
        <view class="slot-header">
          <text>下午</text>
          <text class="period-calories" wx:if="{{periodCalories.afternoon > 0}}">{{periodCalories.afternoon}}千卡</text>
        </view>
        <view class="arrow {{expandedSlot === '下午' ? 'expanded' : ''}}">></view>
      </view>
      <view class="time-content" wx:if="{{expandedSlot === '下午'}}">
        <block wx:for="{{dailyCalorieDetail.todayDetails}}" wx:key="index">
          <view class="food-item" wx:if="{{item.intakePeriod === 2}}">
            <view class="food-info">
              <text class="food-name">{{item.foodName}}</text>
              <text class="food-time">{{item.intakeTime}}</text>
            </view>
            <text class="food-calories">{{item.calories}}千卡</text>
          </view>
        </block>
        <view class="no-food" wx:if="{{!periodCalories.afternoon}}">暂无记录</view>
      </view>
    </view>

    <!-- 晚上 -->
    <view class="time-slot-group">
      <view class="time-slot {{expandedSlot === '晚上' ? 'expanded' : ''}}" bindtap="toggleTimeSlot" data-time="晚上">
        <view class="slot-header">
          <text>晚上</text>
          <text class="period-calories" wx:if="{{periodCalories.evening > 0}}">{{periodCalories.evening}}千卡</text>
        </view>
        <view class="arrow {{expandedSlot === '晚上' ? 'expanded' : ''}}">></view>
      </view>
      <view class="time-content" wx:if="{{expandedSlot === '晚上'}}">
        <block wx:for="{{dailyCalorieDetail.todayDetails}}" wx:key="index">
          <view class="food-item" wx:if="{{item.intakePeriod === 3}}">
            <view class="food-info">
              <text class="food-name">{{item.foodName}}</text>
              <text class="food-time">{{item.intakeTime}}</text>
            </view>
            <text class="food-calories">{{item.calories}}千卡</text>
          </view>
        </block>
        <view class="no-food" wx:if="{{!periodCalories.evening}}">暂无记录</view>
      </view>
    </view>
  </view>
</view>
